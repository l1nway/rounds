[Unit]
Description=Rounds free tier (Oracle)
After=network-online.target
Wants=network-online.target

[Service]
User={user}
WorkingDirectory={repo}/backend
EnvironmentFile={repo}/.env
Environment=PYTHONUNBUFFERED=1
ExecStart={uv} run --no-dev --with uvicorn uvicorn rounds.free:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
